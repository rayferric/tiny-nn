#version 450

layout(binding = 0) readonly buffer PredBuf { float data[]; } buf_Pred;
layout(binding = 1) readonly buffer TargetBuf { float data[]; } buf_Target;
layout(binding = 2) readonly buffer OutGradBuf { float data[]; } buf_OutGrad;
layout(binding = 3) buffer PredGradBuf { float data[]; } buf_PredGrad;

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint num_classes;
} u_PC;

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

shared float shared_max_logit[256];
shared float shared_sum_exp[256];

void main() {
    uint batch_idx = gl_WorkGroupID.x;
    uint thread_idx = gl_LocalInvocationID.x;
    uint num_threads = gl_WorkGroupSize.x;
    
    if (batch_idx >= u_PC.batch_size) {
        return;
    }
    
    uint base_idx = batch_idx * u_PC.num_classes;
    float scale = buf_OutGrad.data[0] / float(u_PC.batch_size);
    
    // recompute max logit
    float local_max = -1e38;
    for (uint i = thread_idx; i < u_PC.num_classes; i += num_threads) {
        local_max = max(local_max, buf_Pred.data[base_idx + i]);
    }
    shared_max_logit[thread_idx] = local_max;
    barrier();
    
    for (uint stride = num_threads / 2; stride > 0; stride /= 2) {
        if (thread_idx < stride) {
            shared_max_logit[thread_idx] = max(shared_max_logit[thread_idx], 
                                                shared_max_logit[thread_idx + stride]);
        }
        barrier();
    }
    float max_logit = shared_max_logit[0];
    
    // recompute sum exp
    float local_sum = 0.0;
    for (uint i = thread_idx; i < u_PC.num_classes; i += num_threads) {
        local_sum += exp(buf_Pred.data[base_idx + i] - max_logit);
    }
    shared_sum_exp[thread_idx] = local_sum;
    barrier();
    
    for (uint stride = num_threads / 2; stride > 0; stride /= 2) {
        if (thread_idx < stride) {
            shared_sum_exp[thread_idx] += shared_sum_exp[thread_idx + stride];
        }
        barrier();
    }
    float sum_exp = shared_sum_exp[0];
    
    // compute and write gradients
    for (uint i = thread_idx; i < u_PC.num_classes; i += num_threads) {
        float logit = buf_Pred.data[base_idx + i];
        float softmax = exp(logit - max_logit) / sum_exp;
        float tgt = buf_Target.data[base_idx + i];
        buf_PredGrad.data[base_idx + i] += scale * (softmax - tgt);
    }
}
